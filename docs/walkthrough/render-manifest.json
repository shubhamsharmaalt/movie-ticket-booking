  ],
  "fps": 30,
  "voice": "Samantha",
  "words_per_minute": 185,
  "segments": [
    {
      "segment": 1,
      "chapter": 1,
      "start": 0.0,
      "end": 6.967,
      "text": "This walkthrough follows the movie ticket booking API from REST controllers through business logic to database transactions.",
      "code_font_px": null
    },
    {
      "segment": 2,
      "chapter": 1,
      "start": 6.967,
      "end": 18.867,
      "text": "Controllers handle HTTP, services own rules, and repositories persist entities. Separate packages contain records, security, jobs, errors, and calculations.",
      "code_font_px": null
    },
    {
      "source": "src/main/java/com/example/movietickets/MovieTicketsApplication.java",
      "ranges": [
        [
          7,
          13
        ]
      ],
      "source_sha256": "54b65b1a44436ed7950ee67825e5cf9ae242420d9e8f8f12490e836f0a29afa9",
      "segment": 3,
      "chapter": 1,
      "start": 18.867,
      "end": 27.6,
      "text": "MovieTicketsApplication starts Spring Boot and scheduling. Environment variables supply database credentials, and Flyway manages the schema.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/config/SecurityConfiguration.java",
      "ranges": [
        [
          34,
          45
        ]
      ],
      "source_sha256": "a93970104447eb0c8122811864499107179407fa13551b0f67411aa7f5895614",
      "segment": 4,
      "chapter": 2,
      "start": 27.6,
      "end": 37.833,
      "text": "SecurityConfiguration uses HTTP Basic with admin and customer roles. Catalog browsing is public, while management and booking routes require the correct role.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/controller/BookingController.java",
      "ranges": [
        [
          31,
          42
        ]
      ],
      "source_sha256": "6ca6db49b25d7db5ddbad1e474abd8cbb85f128125c976c38c1b265358fe72fd",
      "segment": 5,
      "chapter": 2,
      "start": 37.833,
      "end": 46.9,
      "text": "BookingController exposes hold, pay, and cancel. It validates the body and passes the authenticated username to BookingService for ownership checks.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/controller/BookingController.java",
      "ranges": [
        [
          44,
          57
        ]
      ],
      "source_sha256": "6ca6db49b25d7db5ddbad1e474abd8cbb85f128125c976c38c1b265358fe72fd",
      "segment": 6,
      "chapter": 2,
      "start": 46.9,
      "end": 54.3,
      "text": "The get and history methods return the customer's own bookings. The inbox endpoint returns that customer's delivered notifications.",
      "code_font_px": 26
    },
    {
      "source": "src/main/java/com/example/movietickets/dto/ApiModels.java",
      "ranges": [
        [
          43,
          50
        ]
      ],
      "source_sha256": "2a317fc8401373343a31ebde0c3796beac50aa19347fea46fd5287b19ab6c854",
      "segment": 7,
      "chapter": 3,
      "start": 54.3,
      "end": 65.2,
      "text": "ApiModels holds request and response records. Validation checks required fields, price precision, percentages, and seat-list size before business logic runs.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/error/ApiErrors.java",
      "ranges": [
        [
          17,
          28
        ]
      ],
      "source_sha256": "6705e2ccf096960a4d4932f817351f42a1e68831776c5587b08fdc7357691ad4",
      "segment": 8,
      "chapter": 3,
      "start": 65.2,
      "end": 76.333,
      "text": "ApiException represents expected failures. ApiErrors maps invalid input to bad requests, and seat or database conflicts to conflict responses with useful messages.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/controller/CatalogController.java",
      "ranges": [
        [
          63,
          73
        ]
      ],
      "source_sha256": "7e5c724b99b56d0315e66eb084c7797d5a77e9723a813b89d3c34ef0f3656073",
      "segment": 9,
      "chapter": 4,
      "start": 76.333,
      "end": 87.933,
      "text": "CatalogController delegates catalog management to CatalogService, covering cities, theaters, seats, movies, shows, pricing, discounts, and refund policies.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/CatalogService.java",
      "ranges": [
        [
          195,
          205
        ]
      ],
      "source_sha256": "9259bbc89ea134f52a1f80c60ade78866dcd56d5a206030f002876d28c1d32f5",
      "segment": 10,
      "chapter": 4,
      "start": 87.933,
      "end": 96.367,
      "text": "createShow locks the theater, validates the schedule, and creates a ShowSeat row for every seat. The lock also coordinates concurrent layout edits.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/CatalogService.java",
      "ranges": [
        [
          239,
          252
        ]
      ],
      "source_sha256": "9259bbc89ea134f52a1f80c60ade78866dcd56d5a206030f002876d28c1d32f5",
      "segment": 11,
      "chapter": 4,
      "start": 96.367,
      "end": 105.0,
      "text": "browseShows filters future shows by city and local date, with database pagination. Protected admin edits preserve the meaning of existing bookings.",
      "code_font_px": 27
    },
    {
      "segment": 12,
      "chapter": 5,
      "start": 105.0,
      "end": 115.433,
      "text": "City, Theater, TheaterSeat, Movie, and MovieShow describe the catalog. Booking and BookingSeat retain ownership, totals, and seat-price snapshots for history.",
      "code_font_px": null
    },
    {
      "source": "src/main/java/com/example/movietickets/entity/ShowSeat.java",
      "ranges": [
        [
          13,
          22
        ]
      ],
      "source_sha256": "8f45f5fdc0acf1eba0d5d5665f9149f0de16e135b6db5ad26e15156919c9f740",
      "segment": 13,
      "chapter": 5,
      "start": 115.433,
      "end": 125.367,
      "text": "Payment, Refund, and Notification store outcomes. ShowSeat is the allocation authority: it keeps availability, the current booking, and the hold deadline.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/repository/ShowSeatRepository.java",
      "ranges": [
        [
          12,
          21
        ]
      ],
      "source_sha256": "36a86a5dd24b008323774ad6b82da99f126f67001748f4b5f76a05567320f793",
      "segment": 14,
      "chapter": 5,
      "start": 125.367,
      "end": 135.9,
      "text": "Repository interfaces handle persistence. ShowSeatRepository's lockOne and lockByBooking request database write locks, keeping competing updates inside transactions.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/BookingService.java",
      "ranges": [
        [
          64,
          74
        ]
      ],
      "source_sha256": "4499fcffc3908887c2c4190c9d5b61761644071ffa90d6b9bb551dea364edad6",
      "segment": 15,
      "chapter": 6,
      "start": 135.9,
      "end": 142.2,
      "text": "BookingService.hold checks distinct seat IDs, locks the show, and processes seats in sorted order.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/BookingService.java",
      "ranges": [
        [
          79,
          88
        ]
      ],
      "source_sha256": "4499fcffc3908887c2c4190c9d5b61761644071ffa90d6b9bb551dea364edad6",
      "segment": 16,
      "chapter": 6,
      "start": 142.2,
      "end": 148.267,
      "text": "Booked seats and unexpired holds are rejected, so the transaction cannot allocate the same seat twice.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/BookingService.java",
      "ranges": [
        [
          98,
          108
        ]
      ],
      "source_sha256": "4499fcffc3908887c2c4190c9d5b61761644071ffa90d6b9bb551dea364edad6",
      "segment": 17,
      "chapter": 6,
      "start": 148.267,
      "end": 156.7,
      "text": "It saves the booking and seat snapshots in the same transaction. The hold ends after five minutes, or when the show starts, whichever comes first.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/util/PricingCalculator.java",
      "ranges": [
        [
          12,
          18
        ]
      ],
      "source_sha256": "653f8ecbb405a9357333e66793c46342cf2d7e064fd2f13e4c91dce18b669c6f",
      "segment": 18,
      "chapter": 7,
      "start": 156.7,
      "end": 166.1,
      "text": "PricingCalculator starts from the regular or premium seat price. seatPrice applies the weekend surcharge using the city's time zone and rounds to two decimal places.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/BookingService.java",
      "ranges": [
        [
          90,
          101
        ]
      ],
      "source_sha256": "4499fcffc3908887c2c4190c9d5b61761644071ffa90d6b9bb551dea364edad6",
      "segment": 19,
      "chapter": 7,
      "start": 166.1,
      "end": 175.567,
      "text": "A valid discount reduces the subtotal through applyDiscount. BookingService checks the code's active window and saves the result, so later price edits cannot change it.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/BookingService.java",
      "ranges": [
        [
          110,
          122
        ]
      ],
      "source_sha256": "4499fcffc3908887c2c4190c9d5b61761644071ffa90d6b9bb551dea364edad6",
      "segment": 20,
      "chapter": 8,
      "start": 175.567,
      "end": 184.2,
      "text": "pay locks the customer's booking and checks its deadline and continued ownership of every seat. A failed simulated payment keeps the booking held until expiry.",
      "code_font_px": 26
    },
    {
      "source": "src/main/java/com/example/movietickets/service/BookingService.java",
      "ranges": [
        [
          123,
          134
        ]
      ],
      "source_sha256": "4499fcffc3908887c2c4190c9d5b61761644071ffa90d6b9bb551dea364edad6",
      "segment": 21,
      "chapter": 8,
      "start": 184.2,
      "end": 195.9,
      "text": "Success records payment, freezes the refund policy, confirms the booking, marks its seats booked, and queues a notification. Repeating success returns the existing result without another payment.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/BookingService.java",
      "ranges": [
        [
          136,
          143
        ]
      ],
      "source_sha256": "4499fcffc3908887c2c4190c9d5b61761644071ffa90d6b9bb551dea364edad6",
      "segment": 22,
      "chapter": 9,
      "start": 195.9,
      "end": 203.6,
      "text": "cancel allows the owner to cancel a confirmed booking before the show starts. A repeated cancellation returns the existing result.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/BookingService.java",
      "ranges": [
        [
          144,
          152
        ]
      ],
      "source_sha256": "4499fcffc3908887c2c4190c9d5b61761644071ffa90d6b9bb551dea364edad6",
      "segment": 23,
      "chapter": 9,
      "start": 203.6,
      "end": 214.033,
      "text": "RefundCalculator.amount applies the saved cutoffs to the amount paid. The service records a simulated refund, releases seats, and queues cancellation in one transaction.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/BookingService.java",
      "ranges": [
        [
          154,
          161
        ]
      ],
      "source_sha256": "4499fcffc3908887c2c4190c9d5b61761644071ffa90d6b9bb551dea364edad6",
      "segment": 24,
      "chapter": 10,
      "start": 214.033,
      "end": 223.233,
      "text": "MaintenanceJobs finds overdue holds and calls expireOne. That method locks the booking, marks it expired, and releases seats that still belong to it.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/CatalogService.java",
      "ranges": [
        [
          258,
          266
        ]
      ],
      "source_sha256": "9259bbc89ea134f52a1f80c60ade78866dcd56d5a206030f002876d28c1d32f5",
      "segment": 25,
      "chapter": 10,
      "start": 223.233,
      "end": 233.467,
      "text": "Availability and booking operations also check expiry directly. Therefore, a delayed cleanup job cannot extend a hold, and another customer can reclaim an expired seat.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/NotificationService.java",
      "ranges": [
        [
          34,
          37
        ]
      ],
      "source_sha256": "9ae779cc3c2de2ca3daecba17f638602bac0dc12d8f4acd883387b9e69e88ef5",
      "segment": 26,
      "chapter": 11,
      "start": 233.467,
      "end": 239.7,
      "text": "Confirmation and cancellation transactions call NotificationService.enqueue to store pending messages.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/NotificationService.java",
      "ranges": [
        [
          39,
          50
        ]
      ],
      "source_sha256": "9ae779cc3c2de2ca3daecba17f638602bac0dc12d8f4acd883387b9e69e88ef5",
      "segment": 27,
      "chapter": 11,
      "start": 239.7,
      "end": 246.033,
      "text": "enqueueReminders finds confirmed bookings within one hour of show time, while background jobs handle delivery.",
      "code_font_px": 27
    },
    {
      "source": "src/main/java/com/example/movietickets/service/NotificationService.java",
      "ranges": [
        [
          52,
          66
        ]
      ],
      "source_sha256": "9ae779cc3c2de2ca3daecba17f638602bac0dc12d8f4acd883387b9e69e88ef5",
      "segment": 28,
      "chapter": 11,
      "start": 246.033,
      "end": 256.733,
      "text": "deliverPending rechecks reminders and drops them after cancellation. inbox returns delivered records to the customer. This is a REST inbox, with no external email or SMS provider.",
      "code_font_px": 26
    },
    {
      "source": "src/test/java/com/example/movietickets/integration/ConcurrentHoldIntegrationTest.java",
      "ranges": [
        [
          52,
          59
        ]
      ],
      "source_sha256": "a9719c06064f41385775942984b42c47c0d96030f12c4a728b0ccb21dba6c7d7",
      "segment": 29,
      "chapter": 12,
      "start": 256.733,
      "end": 268.767,
      "text": "The tests cover calculations, ownership, expiry, refunds, notifications, and concurrent requests. This race test starts two customers and expects exactly one seat-hold winner.",
      "code_font_px": 27
    },
    {
      "segment": 30,
      "chapter": 12,
      "start": 268.767,
      "end": 277.2,
      "text": "The local suite has seventeen passing tests. The optional PostgreSQL race is unverified because no database credentials were supplied.",
      "code_font_px": null
    },
    {
      "source": "src/main/resources/application.yml",
      "ranges": [
        [
          1,
          16
        ]
      ],
      "source_sha256": "b368e3186b0b156baab5f1a197d774f8d0ff446f6035f5be3f6d8d0d6177d868",
      "segment": 31,
      "chapter": 12,
      "start": 277.2,
      "end": 290.0,
      "text": "Run Maven tests, then set database variables and start the app using the README. Payments and refunds are simulated; the plan, agent instructions, and skills record document the development workflow.",
      "code_font_px": 24
    }
  ]
}
